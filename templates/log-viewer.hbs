<div class="rnk-log-viewer-container">
  <form class="rnk-log-viewer">
    <header>
      <h2>{{localize "RNKRESERVES.Log.Title"}}</h2>
      <div class="log-controls">
        <select class="rnk-filter-actor">
          <option value="">{{localize "RNKRESERVES.Log.AllActors"}}</option>
          {{#each summary}}
            <option value="{{this.id}}">{{this.name}}</option>
          {{/each}}
        </select>
        <button type="button" class="rnk-export-log" title="{{localize 'RNKRESERVES.Log.ExportTitle'}}">
          <i class="fas fa-download"></i> {{localize "RNKRESERVES.Log.Export"}}
        </button>
        <button type="button" class="rnk-clear-all-log" title="{{localize 'RNKRESERVES.Log.ClearAllTitle'}}">
          <i class="fas fa-trash"></i> {{localize "RNKRESERVES.Log.ClearAll"}}
        </button>
      </div>
    </header>

    <section class="log-summary">
      <h3>{{localize "RNKRESERVES.Log.CurrentSummary"}}</h3>
      <p>{{localize "RNKRESERVES.Log.TotalEntries"}}: <strong>{{totalEntries}}</strong> | {{localize "RNKRESERVES.Log.TotalSpent"}}: <strong>{{totalSpent}}</strong></p>
      <table class="rnk-summary-table">
        <thead>
          <tr>
            <th>{{localize "RNKRESERVES.Log.Actor"}}</th>
            <th>{{localize "RNKRESERVES.Log.Type"}}</th>
            <th>{{localize "RNKRESERVES.Log.CurrentPoints"}}</th>
            <th>{{localize "RNKRESERVES.Log.LastActivity"}}</th>
            <th>{{localize "RNKRESERVES.Log.Actions"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each summary}}
            <tr>
              <td>{{this.name}}</td>
              <td>{{this.type}}</td>
              <td class="text-center"><strong>{{this.heroPoints}}</strong></td>
              <td class="text-small">
                {{#if this.lastSpend}}
                  {{this.lastSpend.action}} - {{this.lastSpend.date}}
                {{else}}
                  {{localize "RNKRESERVES.Log.Never"}}
                {{/if}}
              </td>
              <td class="text-center">
                <button type="button" class="rnk-reduce-actor-points" data-actor-id="{{this.id}}" data-actor-name="{{this.name}}" data-current-points="{{this.heroPoints}}" title="{{localize 'RNKRESERVES.Log.ReduceActorTitle'}}">
                  <i class="fas fa-minus-circle"></i>
                </button>
                <button type="button" class="rnk-clear-actor-log" data-actor-id="{{this.id}}" data-actor-name="{{this.name}}" title="{{localize 'RNKRESERVES.Log.ClearActorTitle'}}">
                  <i class="fas fa-trash-alt"></i>
                </button>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </section>

    <section class="log-entries">
      <h3>{{localize "RNKRESERVES.Log.RecentActivity"}}</h3>
      {{#if entries}}
        <table class="rnk-log-table">
          <thead>
            <tr>
              <th>{{localize "RNKRESERVES.Log.Date"}}</th>
              <th>{{localize "RNKRESERVES.Log.Actor"}}</th>
              <th>{{localize "RNKRESERVES.Log.Action"}}</th>
              <th>{{localize "RNKRESERVES.Log.PointsSpent"}}</th>
              <th>{{localize "RNKRESERVES.Log.PointsRemaining"}}</th>
              <th>{{localize "RNKRESERVES.Log.By"}}</th>
            </tr>
          </thead>
          <tbody>
            {{#each entries}}
              <tr data-actor-id="{{this.actorId}}" class="log-entry">
                <td class="text-small">{{this.date}}</td>
                <td><strong>{{this.actorName}}</strong></td>
                <td>{{this.action}}</td>
                <td class="text-center">{{this.pointsSpent}}</td>
                <td class="text-center"><strong>{{this.pointsRemaining}}</strong></td>
                <td class="text-small">{{this.userName}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      {{else}}
        <p class="text-center text-muted">{{localize "RNKRESERVES.Log.Empty"}}</p>
      {{/if}}
    </section>
  </form>
</div>
